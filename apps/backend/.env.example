# ============================================================
# NODOSYS BACKEND · Variables de Entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real a GitHub
# ============================================================

# ── Base de Datos (local para desarrollo) ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=nodosys_dev

# ── JWT (cambia esto por una cadena secreta larga y aleatoria) ──
JWT_SECRET=cambia_esto_por_algo_muy_secreto_y_largo_123456
JWT_EXPIRES_IN=7d

# ── App ──
PORT=3001
NODE_ENV=development

# ── Supabase (para storage de fotos - llenar cuando tengas cuenta) ──
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_KEY=tu_service_key_aqui
